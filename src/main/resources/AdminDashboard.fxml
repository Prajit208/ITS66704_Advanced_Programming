<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #F4F6F8;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.AdminDashboard">

    <children>
        <HBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <!-- Sidebar -->
            <VBox prefWidth="230.0" spacing="4.0" style="-fx-background-color: #1A1A1A;">
                <padding>
                    <Insets top="28.0" bottom="20.0" left="18.0" right="18.0" />
                </padding>

                <Label text="Admin Panel" textFill="white">
                    <font><Font name="System Bold" size="18.0" /></font>
                    <VBox.margin><Insets bottom="8.0" /></VBox.margin>
                </Label>

                <Label fx:id="welcomeLabel" text="Welcome, Admin" textFill="#C9A876">
                    <font><Font size="12.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Label>

                <Button fx:id="btnSearchResources" onAction="#handleSearchResources" text="Search &amp; Browse Resources"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0D0; -fx-cursor: hand; -fx-background-radius: 6;">
                    <font><Font size="13.0" /></font>
                </Button>

                <Button fx:id="btnManageResources" onAction="#handleManageResources" text="Manage Resources"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0D0; -fx-cursor: hand; -fx-background-radius: 6;">
                    <font><Font size="13.0" /></font>
                </Button>

                <Button fx:id="btnViewBookings" onAction="#handleViewBookings" text="Booking Requests"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0D0; -fx-cursor: hand; -fx-background-radius: 6;">
                    <font><Font size="13.0" /></font>
                </Button>

                <Button fx:id="btnManageUsers" onAction="#handleManageUsers" text="User Accounts"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0D0; -fx-cursor: hand; -fx-background-radius: 6;">
                    <font><Font size="13.0" /></font>
                </Button>

                <Button fx:id="btnViewLogs" onAction="#handleViewLogs" text="System Logs"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0D0; -fx-cursor: hand; -fx-background-radius: 6;">
                    <font><Font size="13.0" /></font>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <Separator style="-fx-background-color: #333333;">
                    <VBox.margin><Insets top="10.0" bottom="10.0" /></VBox.margin>
                </Separator>

                <Button fx:id="btnLogout" onAction="#handleLogout" text="Logout"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #EF5350; -fx-cursor: hand; -fx-background-radius: 6;">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </VBox>

            <!-- Content area -->
            <VBox spacing="24.0" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="40.0" left="50.0" right="50.0" bottom="30.0" />
                </padding>

                <VBox spacing="4.0">
                    <Label text="Dashboard">
                        <font><Font name="System Bold" size="26.0" /></font>
                    </Label>
                    <Label text="System-wide overview" textFill="#718096">
                        <font><Font size="13.0" /></font>
                    </Label>
                </VBox>

                <!-- Stat cards -->
                <HBox spacing="16.0">
                    <VBox spacing="6.0" prefWidth="170.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                        <padding><Insets top="18.0" bottom="18.0" left="20.0" right="20.0" /></padding>
                        <Label fx:id="statTotalUsers" text="0" textFill="#1A1A1A">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Total Users" textFill="#718096">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="6.0" prefWidth="170.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                        <padding><Insets top="18.0" bottom="18.0" left="20.0" right="20.0" /></padding>
                        <Label fx:id="statPendingBookings" text="0" textFill="#C9A876">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Pending Bookings" textFill="#718096">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="6.0" prefWidth="170.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                        <padding><Insets top="18.0" bottom="18.0" left="20.0" right="20.0" /></padding>
                        <Label fx:id="statTotalBookings" text="0" textFill="#1A1A1A">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Total Bookings" textFill="#718096">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="6.0" prefWidth="170.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                        <padding><Insets top="18.0" bottom="18.0" left="20.0" right="20.0" /></padding>
                        <Label fx:id="statTotalResources" text="0" textFill="#1A1A1A">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Total Resources" textFill="#718096">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="6.0" prefWidth="170.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                        <padding><Insets top="18.0" bottom="18.0" left="20.0" right="20.0" /></padding>
                        <Label fx:id="statAvailableResources" text="0" textFill="#1A1A1A">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Available Now" textFill="#718096">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>
                </HBox>

                <!-- Recent booking requests preview -->
                <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"
                      VBox.vgrow="ALWAYS">
                    <padding><Insets top="18.0" bottom="18.0" left="20.0" right="20.0" /></padding>

                    <Label text="Recent Booking Requests">
                        <font><Font name="System Bold" size="15.0" /></font>
                    </Label>

                    <TableView fx:id="recentBookingsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colRecentResource" text="Resource" prefWidth="120"/>
                            <TableColumn fx:id="colRecentRequestedBy" text="Requested By" prefWidth="140"/>
                            <TableColumn fx:id="colRecentDate" text="Date" prefWidth="110"/>
                            <TableColumn fx:id="colRecentTime" text="Time" prefWidth="130"/>
                            <TableColumn fx:id="colRecentStatus" text="Status" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>

        </HBox>
    </children>
</AnchorPane>