<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.BookingForm"
            prefHeight="500.0" prefWidth="800.0">

    <Label text="Book Resource" layoutX="330" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Resource ID" layoutX="30" layoutY="70"/>
    <TextField fx:id="resourceIdField" layoutX="30" layoutY="90" prefWidth="200" editable="false"/>

    <Label text="Date" layoutX="250" layoutY="70"/>
    <DatePicker fx:id="bookingDatePicker" layoutX="250" layoutY="90" prefWidth="180"/>

    <Label text="Start Time" layoutX="450" layoutY="70"/>
    <ComboBox fx:id="startTimeBox" layoutX="450" layoutY="90" prefWidth="120" promptText="Select time"/>

    <Label text="Duration (hrs)" layoutX="590" layoutY="70"/>
    <ComboBox fx:id="durationBox" layoutX="590" layoutY="90" prefWidth="100"/>

    <Button fx:id="btnConfirmBooking" text="Confirm Booking" onAction="#handleConfirmBooking"
            layoutX="30" layoutY="140" prefWidth="180"
            style="-fx-background-color:#1565C0; -fx-text-fill:white;"/>

    <!-- Admin-only override, hidden by default -->
    <CheckBox fx:id="overrideAvailabilityCheck" text="Override availability (Admin)"
              layoutX="230" layoutY="145" visible="false" managed="false"/>

    <Separator layoutX="30" layoutY="190" prefWidth="740"/>

    <Label text="My Bookings" layoutX="30" layoutY="205" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="bookingTable" layoutX="30" layoutY="235" prefWidth="740" prefHeight="180">
        <columns>
            <TableColumn fx:id="colBookingId" text="Booking ID" prefWidth="100"/>
            <TableColumn fx:id="colResourceId" text="Resource ID" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
            <TableColumn fx:id="colTime" text="Time" prefWidth="120"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="140"/>
        </columns>
    </TableView>

    <!-- Staff can modify, Student can only cancel their own -->
    <Button fx:id="btnCancelBooking" text="Cancel Selected" onAction="#handleCancelBooking"
            layoutX="30" layoutY="430" prefWidth="150"
            style="-fx-background-color:#C62828; -fx-text-fill:white;"/>

    <Button fx:id="btnModifyBooking" text="Modify Selected" onAction="#handleModifyBooking"
            layoutX="200" layoutY="430" prefWidth="150" visible="false" managed="false"/>

    <Button fx:id="btnBack" text="Back" onAction="#handleBack" layoutX="650" layoutY="430" prefWidth="100"/>

</AnchorPane>