<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="700.0" style="-fx-background-color: #F4F6F8;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.RegisterForm">

    <children>
        <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="380.0" prefWidth="350"
                      spacing="12" StackPane.alignment="CENTER"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:28;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.15),15,0,0,5);">

                    <Label style="-fx-font-size:22px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#A61B29;" text="Create Account" />

                    <Label style="-fx-font-size:12px;
                                  -fx-text-fill:#777;" text="Register to continue" />

                    <Separator />

                    <TextField fx:id="fullNameField" prefHeight="32" prefWidth="300" promptText="Full Name" />

                    <TextField fx:id="usernameField" prefHeight="32" prefWidth="300" promptText="Username" />

                    <TextField fx:id="emailField" prefHeight="32" prefWidth="300" promptText="Email Address" />

<!--                    <ComboBox fx:id="roleComboBox" prefHeight="32" prefWidth="300" promptText="Select Role" />-->

                    <PasswordField fx:id="passwordField" prefHeight="32" prefWidth="300" promptText="Password" />

                    <PasswordField fx:id="confirmPasswordField" prefHeight="32" prefWidth="300" promptText="Confirm Password" />

                    <Label fx:id="messageLabel" textFill="#E53E3E" />

                    <Button fx:id="btnRegister" onAction="#handleRegister" prefHeight="35" prefWidth="300"
                            style="-fx-background-color:#A61B29;
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:6;
                                   -fx-cursor:hand;" text="Register" />

                    <Hyperlink onAction="#handleBack" text="Already have an account? Login"
                               style="-fx-text-fill:#A61B29;" />

                </VBox>

            </children>
        </StackPane>
    </children>

</AnchorPane>