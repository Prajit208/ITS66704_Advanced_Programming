<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0"
            style="-fx-background-color:#F4F6F8;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.ResourceManagement">

    <children>
        <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <!-- SIDEBAR -->
            <VBox prefWidth="230" spacing="10" style="-fx-background-color:#1A1A1A;">
                <padding><Insets top="28" left="18" right="18"/></padding>

                <Label text="Admin Panel" textFill="white">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>

                <Label text="Manage Resources" textFill="#C9A876">
                    <font><Font size="13"/></font>
                </Label>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Back Dashboard" onAction="#backDashboard" prefHeight="40" maxWidth="Infinity"
                        style="-fx-background-color:transparent; -fx-text-fill:#D0D0D0; -fx-cursor:hand;"/>
            </VBox>

            <!-- CONTENT -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <padding><Insets top="35" left="45" right="45"/></padding>

                <Label text="Resource Management">
                    <font><Font name="System Bold" size="26"/></font>
                </Label>

                <GridPane hgap="15" vgap="12">
                    <Label text="Resource ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="resourceIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Type" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="typeBox" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Location" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="locationField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Capacity" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="capacityField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Booking Rules" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="rulesField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Comma-separated"/>

                    <Label text="Available" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="availableCheck" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="12">
                    <Button text="Add" onAction="#addResource" prefWidth="100"
                            style="-fx-background-color:#4CAF50; -fx-text-fill:white;"/>
                    <Button text="Remove" onAction="#removeResource" prefWidth="100"
                            style="-fx-background-color:#E53935; -fx-text-fill:white;"/>
                </HBox>

                <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colResourceId" text="Resource ID" prefWidth="100"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="colLocation" text="Location" prefWidth="150"/>
                        <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="90"/>
                        <TableColumn fx:id="colAvailability" text="Availability" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </children>
</AnchorPane>