<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: linear-gradient(to bottom right, #A61B29, #7A1420);"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.LandingPage">

    <children>
        <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxWidth="620.0" spacing="16.0" StackPane.alignment="CENTER">

                    <!-- Main Brand Name -->
                    <Label text="CampusConnect" textFill="white"
                           textAlignment="CENTER" wrapText="true">
                        <font>
                            <Font name="System Bold" size="48.0" />
                        </font>
                    </Label>

                    <!-- Sub-heading System Title (Soft Gray) -->
                    <Label text="Campus Resource Booking System" textFill="#D1D5DB"
                           textAlignment="CENTER" wrapText="true">
                        <font>
                            <Font name="System Bold" size="22.0" />
                        </font>
                    </Label>

                    <!-- Meaningful Mission Tagline -->
                    <Label text="“Connecting students and staff with the spaces they need to collaborate, innovate, and succeed.”"
                           textFill="#E2E8F0" textAlignment="CENTER" wrapText="true" style="-fx-font-style: italic;">
                        <font>
                            <Font size="15.0" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="12.0" top="4.0" />
                        </VBox.margin>
                    </Label>

                    <Button fx:id="btnGetStarted" onAction="#handleGetStarted" prefHeight="48.0" prefWidth="220.0"
                            style="-fx-background-color: #FFFFFF; -fx-text-fill: #A61B29; -fx-background-radius: 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 6);"
                            text="Get Started">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>

                </VBox>
            </children>
        </StackPane>
    </children>

</AnchorPane>