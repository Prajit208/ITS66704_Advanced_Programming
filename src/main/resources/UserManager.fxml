<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0"
            style="-fx-background-color:#F4F6F8;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.UserManager">

    <children>
        <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <!-- SIDEBAR -->
            <VBox prefWidth="230" spacing="4" style="-fx-background-color:#1A1A1A;">
                <padding><Insets top="28" bottom="20" left="18" right="18"/></padding>

                <Label text="Admin Panel" textFill="white">
                    <font><Font name="System Bold" size="18"/></font>
                    <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                </Label>

                <Label text="Manage Users" textFill="#C9A876">
                    <font><Font size="13"/></font>
                </Label>

                <Region VBox.vgrow="ALWAYS"/>

                <Separator style="-fx-background-color: #333333;">
                    <VBox.margin><Insets top="10.0" bottom="10.0"/></VBox.margin>
                </Separator>

                <Button text="Back to Dashboard" onAction="#backDashboard"
                        alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="42.0"
                        style="-fx-background-color:transparent; -fx-text-fill:#D0D0D0; -fx-cursor:hand; -fx-background-radius:6;">
                    <font><Font size="13.0"/></font>
                </Button>
            </VBox>

            <!-- CONTENT -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <padding><Insets top="35" left="45" right="45" bottom="30"/></padding>

                <VBox spacing="4.0">
                    <Label text="User Management">
                        <font><Font name="System Bold" size="26"/></font>
                    </Label>
                    <Label text="Create, edit, or remove Staff and Admin accounts" textFill="#718096">
                        <font><Font size="13.0"/></font>
                    </Label>
                </VBox>

                <!-- Form card -->
                <VBox spacing="14.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <padding><Insets top="20.0" bottom="20.0" left="20.0" right="20.0"/></padding>

                    <HBox spacing="16.0">
                        <VBox spacing="4.0">
                            <Label text="Full Name" textFill="#4A5568"><font><Font name="System Bold" size="11.0"/></font></Label>
                            <TextField fx:id="fullNameField" prefWidth="200"
                                       style="-fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;"/>
                        </VBox>

                        <VBox spacing="4.0">
                            <Label text="Username" textFill="#4A5568"><font><Font name="System Bold" size="11.0"/></font></Label>
                            <TextField fx:id="usernameField" prefWidth="180"
                                       style="-fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;"/>
                        </VBox>

                        <VBox spacing="4.0">
                            <Label text="Email" textFill="#4A5568"><font><Font name="System Bold" size="11.0"/></font></Label>
                            <TextField fx:id="emailField" prefWidth="220"
                                       style="-fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;"/>
                        </VBox>

                        <VBox spacing="4.0">
                            <Label text="Role" textFill="#4A5568"><font><Font name="System Bold" size="11.0"/></font></Label>
                            <ComboBox fx:id="roleBox" prefWidth="130"/>
                        </VBox>
                    </HBox>

                    <Label text="Default password for new users: default123" textFill="#718096">
                        <font><Font size="12"/></font>
                    </Label>

                    <HBox spacing="12">
                        <Button text="Create" onAction="#createUser" prefWidth="110" prefHeight="38"
                                style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-background-radius:6; -fx-cursor:hand;">
                            <font><Font name="System Bold" size="12.0"/></font>
                        </Button>

                        <Button text="Update" onAction="#updateUser" prefWidth="110" prefHeight="38"
                                style="-fx-background-color:#2196F3; -fx-text-fill:white; -fx-background-radius:6; -fx-cursor:hand;">
                            <font><Font name="System Bold" size="12.0"/></font>
                        </Button>

                        <Button text="Delete" onAction="#deleteUser" prefWidth="110" prefHeight="38"
                                style="-fx-background-color:#E53935; -fx-text-fill:white; -fx-background-radius:6; -fx-cursor:hand;">
                            <font><Font name="System Bold" size="12.0"/></font>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Table card -->
                <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"
                      VBox.vgrow="ALWAYS">
                    <padding><Insets top="8.0" bottom="8.0" left="8.0" right="8.0"/></padding>

                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="160"/>
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="160"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </HBox>
    </children>
</AnchorPane>