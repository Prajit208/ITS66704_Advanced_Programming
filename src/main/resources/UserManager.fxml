<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0"
            style="-fx-background-color:#F4F6F8;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="manager.UserManager">

    <children>

        <HBox AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">


            <!-- SIDEBAR -->
            <VBox prefWidth="230"
                  spacing="10"
                  style="-fx-background-color:#1A1A1A;">

                <padding>
                    <Insets top="28" left="18" right="18"/>
                </padding>


                <Label text="Admin Panel"
                       textFill="white">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>


                <Label text="Manage Users"
                       textFill="#C9A876">
                    <font>
                        <Font size="13"/>
                    </font>
                </Label>


                <Region VBox.vgrow="ALWAYS"/>


                <Button text="Back Dashboard"
                        onAction="#backDashboard"
                        prefHeight="40"
                        maxWidth="Infinity"
                        style="
                        -fx-background-color:transparent;
                        -fx-text-fill:#D0D0D0;
                        -fx-cursor:hand;"/>

            </VBox>



            <!-- CONTENT -->

            <VBox spacing="20"
                  HBox.hgrow="ALWAYS">

                <padding>
                    <Insets top="35"
                            left="45"
                            right="45"/>
                </padding>


                <Label text="User Management">
                    <font>
                        <Font name="System Bold" size="26"/>
                    </font>
                </Label>


                <!-- USER FORM -->

                <GridPane hgap="15"
                          vgap="12">

                    <!-- Full Name -->

                    <Label text="Full Name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="fullNameField"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <!-- Username -->

                    <Label text="Username"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="usernameField"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>


                    <!-- Email -->

                    <Label text="Email"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="emailField"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>


                    <!-- Role -->

                    <Label text="Role"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="roleBox"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"/>


                </GridPane>

                <!-- Default password information -->

                <Label text="Default password for new users: default123"
                       textFill="#718096">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>


                <!-- BUTTONS -->


                <HBox spacing="12">

                    <Button text="Create"
                            onAction="#createUser"
                            prefWidth="100"
                            style="
                            -fx-background-color:#4CAF50;
                            -fx-text-fill:white;"/>


                    <Button text="Update"
                            onAction="#updateUser"
                            prefWidth="100"
                            style="
                            -fx-background-color:#2196F3;
                            -fx-text-fill:white;"/>


                    <Button text="Delete"
                            onAction="#deleteUser"
                            prefWidth="100"
                            style="
                            -fx-background-color:#E53935;
                            -fx-text-fill:white;"/>


                </HBox>



                <!-- TABLE -->


                <TableView fx:id="userTable"
                           VBox.vgrow="ALWAYS">


                    <columns>

                        <TableColumn fx:id="nameColumn"
                                     text="Full Name"
                                     prefWidth="160"/>


                        <TableColumn fx:id="usernameColumn"
                                     text="Username"
                                     prefWidth="160"/>


                        <TableColumn fx:id="emailColumn"
                                     text="Email"
                                     prefWidth="200"/>


                        <TableColumn fx:id="roleColumn"
                                     text="Role"
                                     prefWidth="120"/>


                    </columns>


                </TableView>


            </VBox>


        </HBox>


    </children>


</AnchorPane>